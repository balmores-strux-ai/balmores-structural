# Copy to .env for local development (not committed).

# ETABS dataset script (etabs_brain_full.py): set ETABS_HIDE=1 to run without showing the ETABS window.
# Wider archetype variety: ETABS_ARCHETYPE_RANDOM_FRACTION=0.15  (default ~0.12 in CONFIG)

# Path to the structural brain checkpoint (.pt). Absolute, or relative to backend/ root.
# Default: models/etabs_parametric_structural_brain.pt (train_brain.py writes here).
# BALMORES_BRAIN_PT=models/checkpoints/brain_10hr_latest.pt

# Optional: Postgres or SQLite persistence (default: in-memory only)
# SQLite file example:
# DATABASE_URL=sqlite:///./data/balmores.db
# Render Postgres (use Internal URL); prefix postgres:// is auto-normalized to postgresql://
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated origins for browser CORS (production). Default * (dev-friendly).
# ALLOWED_ORIGINS=https://www.balmoreslab.com,https://balmoreslab.com

# Optional error tracking
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Show real error messages in 500 responses (development only)
# DEBUG=1

# Optional: require X-API-Key or Authorization: Bearer on /chat, /verify, exports (not /health or /ready)
# API_KEY=

# Access logs to stdout: ACCESS_LOG=1 (plain) or ACCESS_LOG_JSON=1 (one JSON line per request with duration_ms)
# ACCESS_LOG=1
# ACCESS_LOG_JSON=1

# Max JSON body size for POST /chat and /chat/stream (bytes, default 2097152)
# MAX_BODY_BYTES=2097152

# Expose GET /metrics (Prometheus text). Disable in production unless scraped behind auth.
# METRICS_ENABLED=1

# Send X-Content-Type-Options, X-Frame-Options, Referrer-Policy, Permissions-Policy on responses
# SECURITY_HEADERS=1

# ---------------------------------------------------------------------------
# Local LLM bridge (Ollama + DeepSeek-R1) — see LOCAL_AI_SETUP.md
# ---------------------------------------------------------------------------
# Turn the local DeepSeek-R1 commentary on (default) or off (=0) without code.
# LLM_ENABLED=1
# Where Ollama is listening. MUST be loopback unless you accept the privacy risk.
# LLM_OLLAMA_URL=http://127.0.0.1:11434
# Hardened safety: refuse non-loopback hosts unless this is explicitly 1.
# LLM_ALLOW_REMOTE=0
# Model tag (matches `ollama list`).
# LLM_MODEL=deepseek-r1:latest
# Decoding knobs (DeepSeek-R1 reasoning fits in ~2k tokens; bump if you see truncation).
# LLM_TEMPERATURE=0.2
# LLM_TOP_P=0.9
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_NUM_CTX=4096
# Keep the model resident in Ollama RAM/VRAM so chats start instantly.
# LLM_KEEP_ALIVE=30m
# Sliding LRU response cache (in process).
# LLM_CACHE_SIZE=64
# Per-IP token-bucket on /llm/* (capacity + refill per second).
# LLM_RATE_CAPACITY=30
# LLM_RATE_REFILL_PER_SEC=0.5
# Hard ceiling for upload size into the LLM (chars, both prompt and FEM JSON).
# LLM_MAX_INPUT_CHARS=16000
# Stream timeout (seconds) — DeepSeek-R1 8B on CPU may need >2 min for big jobs.
# LLM_TIMEOUT_SECONDS=300
